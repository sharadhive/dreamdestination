{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/locations/:slug",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/overseas-education-consultants-in-:slug",
      "destination": "/study-abroad-consultants-in-:slug",
      "permanent": true
    },
    {
      "source": "/overseas-education-consultant-in-:slug",
      "destination": "/study-abroad-consultants-in-:slug",
      "permanent": true
    },
    {
      "source": "/abroad-education-consultants-in-:slug",
      "destination": "/study-abroad-consultants-in-:slug",
      "permanent": true
    },
    {
      "source": "/student-visa-consultants-in-:slug",
      "destination": "/study-abroad-consultants-in-:slug",
      "permanent": true
    },
    {
      "source": "/study-abroad-consultancy-in-:slug",
      "destination": "/study-abroad-consultants-in-:slug",
      "permanent": true
    },
    {
      "source": "/study-abroad-consultant-in-:slug",
      "destination": "/study-abroad-consultants-in-:slug",
      "permanent": true
    },
    {
      "source": "/education-loan-in-:slug",
      "destination": "/study-abroad-consultants-in-:slug",
      "permanent": true
    },
    {
      "source": "/study-abroad-in-:slug",
      "destination": "/study-abroad-consultants-in-:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/og-image.jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/favicon.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), payment=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
